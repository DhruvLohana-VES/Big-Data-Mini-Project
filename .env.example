# LLM Provider Configuration
# Supported providers: 'gemini' (default), 'openai', 'anthropic', 'ollama', 'mock' (offline demo mode)
LLM_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI Configuration (Optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LLM Generation Parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
LLM_MAX_SAMPLES=50
LLM_MAX_RETRIES=3
LLM_RATE_LIMIT_PAUSE=1.0

# LLM Pricing Configuration (Optional for cost tracking, per 1M tokens in USD)
# e.g. for Gemini 1.5 Flash: input=$0.075 / 1M tokens, output=$0.30 / 1M tokens
LLM_INPUT_COST_PER_1M_TOKENS=0.075
LLM_OUTPUT_COST_PER_1M_TOKENS=0.30

# Execution Mode ('demo' for fast execution on CPU, 'full' for full datasets and epochs)
EXECUTION_MODE=demo

# Indic NLP Model Configuration
# Options: 'google/muril-base-cased', 'ai4bharat/indic-bert', 'xlm-roberta-base'
TRANSFORMER_MODEL_NAME=google/muril-base-cased
BATCH_SIZE=8
LEARNING_RATE=2e-5
NUM_EPOCHS=3

# Spark Configuration
SPARK_APP_NAME=IndicCodeMixedSocialAnalytics
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
